@model MVC.Models.Class
<head>
    <style>
        .box{
            background-color: #1A2A474D;
            color: #a6a6a6;
            border: 1px solid #333333;
            border-color: #2A4365;
            border-radius: 20px;
            width: 350px;
            height: 320px;
            padding:15px;
            margin: 10px;
            float: left;
           
        }

        .box_2{
            background-color: #1A2A474D;
            color: #a6a6a6;
            border: 1px solid #333333;
            border-color: #2A4365;
            border-radius: 20px;
            width: 535px;
            height: 270px;
            padding: 15px;
            margin: 10px;
            float: left;
        }
    </style>
    <body style="background-image: linear-gradient(to bottom right, #2a5298 0%, #14213d 50%, #0b132b 100%);">

        <div style="text-align: center; color:#FFFFFF;">
            <h1 style="font-family: Poppins; font-size:60px; font-weight: 800; 
            line-height: 1; "><b>HI-IT'S ME @Model.FirstName </b></h1>
            <h2 style="font-family: san-serif; font-size:40px; font-weight:200;"><i>BSCS 2-1N</i></h2>
        </div>

        <br />
        <br />
        <div style="font-size: 35px; color:#FFFFFF;">
            <h2><b> Student Profile (2025-03026-MN-O): </b></h2>
        </div>

        <div class="box">
            <h3 style="text-align: center"><b>Student Name</b></h3>
            <hr />
            <p><b>First Name:</b> @Model.FirstName</p>
			<p><b>Middle Name:</b> @Model.MiddleName</p>
			<p><b>Last Name:</b> @Model.LastName</p>
			<p><b>Nickname</b>: @Model.Nickname</p>
			<p><b>Suffix:</b> @Model.Suffix</p>
        </div>
    
        <div class="box">
            <h3 style="text-align: center"><b>Personal Details</b></h3>
            <hr />
            <p><b>Birthday:</b> @Model.Birthday</p>
            <p><b>Age:</b> @Model.age</p>
            <p><b>Address:</b> @Model.Address</p>
            <p><b>Religion:</b> @Model.Religion</p>
            <p><b>Contact Number:</b> @Model.ContactNumber</p>
        </div>

        <div class="box">
            <h3 style="text-align: center"><b>Student Details</b> </h3>
            <hr />
            <p><b>Student Number:</b> @Model.StudentNumber</p>
            <p><b>School:</b> @Model.School</p>
            <p><b>Program:</b> @Model.Program</p>
            <p><b>Year Level:</b> @Model.Year</p>
            <p><b>Section:</b> @Model.Section</p>
        </div>

        <div class = "box_2">
            <h3 style="text-align: center"> <b>Additional Information</b> </h3>
            <hr />
            <p><b>Hobbies:</b> @Model.Hobbies</p>
            <p><b>Favorite Kpop Idols:</b> @Model.FavKpop</p>
            <p><b>Fun Fact:</b> @Model.FunFact</p>
        </div>

         <div class = "box_2" style = " text-align: justify">
            <h3 style="text-align: center"> <b>Description About Myself</b> </h3>
            <hr />
            <p>@Model.Description</p>
        </div>

    </body>
</head>
