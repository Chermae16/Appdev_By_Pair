@model MVC.Models.Class

<style>
    body {
        background-image: url('/image/bg.jpg');
        background-size: cover;          /* fills the whole screen */
        background-position: center;     /* keeps the middle of the image visible */
        background-repeat: no-repeat;    /* no tiling */
        background-attachment: fixed;    /* stays put while scrolling */
    }
    /* Banner alignment wrappers */
    .align-right  { text-align: right; }
    .align-center { text-align: center; }
    .align-left   { text-align: left; }

    /* Banner text box */
    .banner {
        display: inline-block;
        margin: 1rem 0 0.5rem;
        padding: 0.5rem;
        font-size: 2.5rem;
        font-weight: 300;
        line-height: 1.2;
        border: 1px solid #212529;
        border-radius: 0.375rem;
    }

    .banner-dark {
        background-color: #212529;
    }

    /* Row holding the three info cards */
    .info-row {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 1rem;
        margin-top: 1rem;
    }

    /* Info card */
    .info-card {
        display: inline-block;
        padding: 1rem;
        border: 1px solid #212529;
        border-radius: 0.375rem;
    }
</style>

<div class="align-right">
    <p class="banner banner-dark">Studenttttt</p>
</div>
<div class="align-right">
    <p class="banner banner-dark">Student Information '_'</p>
</div>
<div class="align-center">
    <p class="banner">Student Information '_'</p>
</div>
<div class="align-left">
    <p class="banner banner-dark">Student Information '_'</p>
</div>
<div class="align-left">
    <p class="banner banner-dark">Studenttttt</p>
</div>

<div class="info-row">
    <div class="info-card">
        <h1>Name-based Information:</h1>
        <p>First Name: @Model.FirstName</p>
        <p>Middle Name: @Model.MiddleName</p>
        <p>Last Name: @Model.LastName</p>
        <p>Nickname: @Model.Nickname</p>
        <p>Age: @Model.Age</p>
    </div>

    <div class="info-card">
        <h1>Additional Information:</h1>
        <p>Residence: @Model.Residence</p>
        <p>Phone Number: @Model.PhoneNumber</p>
        <p>Person to contact in case of emergencies:<br>@Model.MothersName</p>
        <p>Number: @Model.MothersPhoneNumber</p>
    </div>

    <div class="info-card">
        <h1>School-related Information:</h1>
        <p>Student ID: @Model.StudentId</p>
        <p>School Name: @Model.SchoolNameHalf1 <br> @Model.SchoolNameHalf2</p>
        <p>Program: @Model.ProgramHalf1 <br> @Model.ProgramHalf2</p>
        <p>Year Level and Section:<br>@Model.YearLevel @Model.Section</p>
    </div>
</div>